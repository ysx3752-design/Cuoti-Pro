# Copy to .env before deployment. The built-in Agent reuses these OPENAI_*
# settings.
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Use xhigh only with a reasoning model that supports it.
OPENAI_REASONING_EFFORT=none
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_TIMEOUT_SECONDS=120

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=12
TOKEN_REFRESH_THRESHOLD_MINUTES=60
POW_CHALLENGE_TTL_SECONDS=120
POW_DIFFICULTY=4
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
BACKEND_PORT=8000
