APP_NAME=Smart Learning Agent API
APP_ENV=development
# Use the local MySQL80 service configured on this machine.
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/smart_learning_agent?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=12
# Renew authenticated Bearer tokens within this many minutes of expiry. Set 0 to disable.
TOKEN_REFRESH_THRESHOLD_MINUTES=60
# Anonymous login and registration require a one-time SHA-256 proof-of-work challenge.
POW_CHALLENGE_TTL_SECONDS=120
POW_DIFFICULTY=4
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Must support image input for homework grading.
OPENAI_MODEL=gpt-4o
# Use xhigh only with a reasoning model that supports it.
OPENAI_REASONING_EFFORT=none
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=storage
REVIEW_CONFIDENCE_THRESHOLD=0.85
# Demo-level restricted verifier. Use container or micro-VM isolation before
# accepting adversarial code in a public production environment.
SANDBOX_TIMEOUT_SECONDS=2
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_CODE_CHARS=8000
SANDBOX_MAX_OUTPUT_CHARS=8000
# Keep true for a local fallback. Set false for environments managed by Alembic.
AUTO_CREATE_TABLES=true
PLUGIN_MODULES=app.plugins.example,app.plugins.mastery_tracking,app.plugins.wrong_question_book,app.plugins.assignment_grading,app.plugins.layered_practice,app.plugins.stage_assessment,app.plugins.learning_dashboard,app.plugins.learning_insights
